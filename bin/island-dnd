#!/usr/bin/env bash
# ==============================================================================
# island-dnd — Alterna modo Não Perturbe via IPC da ilha e dunstctl
# ==============================================================================
set -euo pipefail

rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
sock="${rt}/island.sock"

if [ -S "$sock" ]; then
    python3 -c '
import socket, json
try:
    sock = "'"$sock"'"
    s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    s.sendto(json.dumps({"action": "dnd_toggle"}).encode("utf-8"), sock)
    s.close()
except Exception:
    pass
'
else
    dunstctl set-paused toggle || true
fi
