#!/usr/bin/env bash
# ==============================================================================
# island-dnd — Alterna modo Não Perturbe via IPC da ilha e dunstctl
# ==============================================================================
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ISLANDCTL="$BIN_DIR/islandctl"
if [ ! -x "$ISLANDCTL" ]; then
    ISLANDCTL="$(command -v islandctl 2>/dev/null || true)"
fi

if [ -n "$ISLANDCTL" ] && [ -x "$ISLANDCTL" ]; then
    exec "$ISLANDCTL" dnd toggle
fi

dunstctl set-paused toggle || true
