#!/usr/bin/env python3
"""island-notify — Envia notificações e alertas diretamente para a Dynamic Island.

Pode ser executado diretamente por scripts, terminal ou chamado pelo Dunst via dunstrc.
"""
import os
import sys
import json
import socket


def main():
    app = os.environ.get("DUNST_APP_NAME", "")
    summary = os.environ.get("DUNST_SUMMARY", "")
    body = os.environ.get("DUNST_BODY", "")
    urgency = os.environ.get("DUNST_URGENCY", "NORMAL")

    if len(sys.argv) > 1:
        if len(sys.argv) == 2:
            summary = sys.argv[1]
            app = app or "Sistema"
        elif len(sys.argv) == 3:
            app = app or sys.argv[1]
            summary = summary or sys.argv[2]
        else:
            app = app or sys.argv[1]
            summary = summary or sys.argv[2]
            body = body or sys.argv[3]
            if len(sys.argv) >= 6 and not os.environ.get("DUNST_URGENCY"):
                urgency = sys.argv[5]

    app = (app or "Sistema").strip()
    summary = (summary or "").strip()
    body = (body or "").strip()

    if app.lower() in ("changevolume", "volume") or "volume" in summary.lower():
        sys.exit(0)

    rt = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sock_path = f"{rt}/island.sock"

    if not os.path.exists(sock_path):
        sys.exit(0)

    payload = {
        "action": "notify",
        "app": app,
        "summary": summary,
        "body": body,
        "urgency": urgency,
        "duration": 3500,
    }

    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.sendto(json.dumps(payload).encode("utf-8"), sock_path)
        s.close()
    except Exception:
        pass


if __name__ == "__main__":
    main()
