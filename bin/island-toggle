#!/usr/bin/env bash
# Alterna a ilha entre presa-aberta e recolhida (via IPC com fallback para SIGUSR1).
# Serve para bindar numa tecla: bind = $mainMod, B, exec, ~/.local/bin/island-toggle
set -euo pipefail

rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
sock="${rt}/island.sock"

if [ -S "$sock" ]; then
    python3 -c '
import socket, json
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    s.sendto(json.dumps({"action": "toggle"}).encode("utf-8"), "'"$sock"'")
    s.close()
except Exception:
    pass
'
else
    pid=$(ps -eo pid,comm,args --no-headers | awk '$2=="python3" && $0 ~ /island\.py/ {print $1; exit}')
    [ -n "$pid" ] && kill -USR1 "$pid"
fi
